# ==============================================================================
# Unhold: Autonomous Cash-Flow & Payment Protection Agent Team
# Environment Configuration Template (Zero Secrets Committed)
# ==============================================================================

# Server Configuration
PORT=10000
HOST=0.0.0.0
NODE_ENV=development

# PayPal Developer Sandbox (https://developer.paypal.com/dashboard)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id_here

# Local SQLite Ledger Database
DATABASE_PATH=./data/unhold.db

# LLM Provider & AI Gateway
LLM_API_KEY=your_llm_api_key_here
LLM_PROVIDER_ENDPOINT=https://ollama.com/v1
LLM_PROVIDER_MODEL=deepseek-v4.1-flash:1017

# AG Grid Community & Enterprise Trial (https://www.ag-grid.com)
AG_GRID_API_KEY=

# Astropods Agent Operating Platform (https://astropods.io)
ASTROPODS_API_KEY=your_astropods_api_key_here

# Render Cloud Hosting & Deployment Diagnostics (https://dashboard.render.com/u/settings?add-api-key)
RENDER_API_KEY=rnd_your_render_api_key_here

# Zapier Webhooks (https://zapier.com - Real-Time Slack Automation)
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/your_hook_id_here/
