# Image for the Astropods blueprint (astropods.yml). A frontend agent must serve HTTP on port 80.
FROM node:24-slim AS builder
WORKDIR /app
COPY package*.json tsconfig.json ./
RUN npm ci
COPY src/ ./src/
RUN npm run build

FROM node:24-slim AS runner
WORKDIR /app

# curl for the platform health check; setcap lets the non-root node user bind port 80
RUN apt-get update \
  && apt-get install -y --no-install-recommends curl libcap2-bin \
  && setcap cap_net_bind_service=+ep "$(readlink -f "$(command -v node)")" \
  && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
ENV PORT=80
ENV HOST=0.0.0.0

COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=builder /app/dist ./dist
COPY public/ ./public/
COPY astropods.yml ./astropods.yml
RUN chown -R node:node /app

USER node
EXPOSE 80
CMD ["node", "dist/server.js"]
